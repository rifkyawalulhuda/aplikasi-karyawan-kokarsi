generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WorkLocation {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  employees Employee[]

  @@map("work_locations")
}

model TaxStatus {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  employees Employee[]

  @@map("tax_status")
}

model ContractType {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(255)
  contracts Contract[]
  templates ContractTemplate[]

  @@map("contract_types")
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(255)
  employees Employee[]

  @@map("departments")
}

model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model UserAccount {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  nik       String    @unique @db.VarChar(100)
  email     String    @unique @db.VarChar(255)
  role      AdminRole @default(PENGELOLA_KOPERASI)
  username  String    @unique @db.VarChar(100)
  password  String    @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_accounts")
}

model JobRole {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  employees Employee[]
  contractTemplates ContractTemplate[]

  @@map("job_roles")
}

model JobLevel {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  employees Employee[]

  @@map("job_levels")
}

model Employee {
  id               Int              @id @default(autoincrement())
  employeeNo       String           @unique @db.VarChar(100)
  fullName         String           @db.VarChar(255)
  nik              String?          @unique @db.VarChar(100)
  birthPlace       String?          @db.VarChar(100)
  address          String?
  employmentStatus EmploymentStatus
  taxStatusId      Int
  departmentId     Int?
  birthDate        DateTime         @db.Date
  gender           Gender
  workLocationId   Int
  jobRoleId        Int
  jobLevelId       Int
  educationLevel   EducationLevel
  joinDate         DateTime         @db.Date
  phoneNumber      String?          @db.VarChar(50)
  email            String           @unique @db.VarChar(255)
  fotoKaryawan     String?

  taxStatus    TaxStatus    @relation(fields: [taxStatusId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workLocation WorkLocation @relation(fields: [workLocationId], references: [id])
  jobRole      JobRole      @relation(fields: [jobRoleId], references: [id])
  jobLevel     JobLevel     @relation(fields: [jobLevelId], references: [id])

  contracts             Contract[]
  statusHistory         EmployeeStatusHistory[]
  offboarding           EmployeeOffboarding?
  masterAdmin           MasterAdmin?
  warningLetters        WarningLetter[]
  employeeDocuments     EmployeeDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

model WarningLetter {
  id              Int      @id @default(autoincrement())
  letterNumber    String   @unique @db.VarChar(100)
  employeeId      Int
  violationType   String[] @db.Text
  warningLevel    Int
  letterDate      DateTime @db.Date
  validUntil      DateTime @db.Date
  processedById   Int
  processedByName String   @db.VarChar(255)
  documentUrl     String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warning_letters")
}

model MasterAdmin {
  id         Int       @id @default(autoincrement())
  employeeNo String    @unique @db.VarChar(100)
  fullName   String    @db.VarChar(255)
  password   String    @db.VarChar(255)
  role       AdminRole @default(ADMIN)
  employee   Employee  @relation(fields: [employeeNo], references: [employeeNo])

  @@map("master_admin")
}

model Contract {
  id             Int            @id @default(autoincrement())
  employeeId     Int
  contractNo     String         @unique @db.VarChar(100)
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  contractTypeId Int?
  templateId     Int?
  status         ContractStatus @default(AKTIF)
  signedDate     DateTime?      @db.Date
  positionLabel  String?        @db.VarChar(255)
  workLocationLabel String?     @db.VarChar(255)
  baseCompensation Int?
  templateData   Json?
  documentUrl    String?
  generatedPdfUrl String?
  generatedAt    DateTime?
  parentContractId Int?

  employee       Employee           @relation(fields: [employeeId], references: [id])
  contractType   ContractType?      @relation(fields: [contractTypeId], references: [id])
  template       ContractTemplate?  @relation(fields: [templateId], references: [id])
  parentContract Contract?          @relation("ContractChain", fields: [parentContractId], references: [id])
  childContracts Contract[]         @relation("ContractChain")
  documents      ContractDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contracts")
}

model ContractTemplate {
  id             Int            @id @default(autoincrement())
  code           String         @unique @db.VarChar(100)
  name           String         @db.VarChar(255)
  family         ContractFamily
  contractTypeId Int?
  jobRoleId      Int?
  description    String?
  templateKey    String         @db.VarChar(100)
  requiredFields Json?
  isActive       Boolean        @default(true)
  version        Int            @default(1)
  notes          String?

  contractType ContractType? @relation(fields: [contractTypeId], references: [id], onDelete: SetNull)
  jobRole      JobRole?      @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  contracts    Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contract_templates")
}

model ContractDocument {
  id         Int      @id @default(autoincrement())
  contractId Int
  fileName   String   @db.VarChar(255)
  fileUrl    String
  uploadedAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id])

  @@map("contract_documents")
}

model EmployeeStatusHistory {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  oldStatus     String   @db.VarChar(30)
  newStatus     String   @db.VarChar(30)
  changedById   Int?
  changedByName String   @db.VarChar(255)
  changedByRole String   @db.VarChar(50)
  changedAt     DateTime @default(now())
  notes         String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_status_history")
}

model EmployeeOffboarding {
  id              Int             @id @default(autoincrement())
  employeeId      Int             @unique
  terminationType TerminationType
  terminationDate DateTime        @db.Date
  reason          String?
  processedById   Int
  processedByName String          @db.VarChar(255)
  processedByRole String          @db.VarChar(50)
  processedByKind String          @db.VarChar(50)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_offboarding")
}

enum EmploymentStatus {
  AKTIF
  KONTRAK_EXPIRED
  RESIGN
  PHK
}

enum Gender {
  MALE
  FEMALE
}

enum EducationLevel {
  SMA
  D3
  S1
  S2
}

enum ContractStatus {
  DRAFT
  AKTIF
  AKAN_HABIS
  EXPIRED
  SELESAI
  DIBATALKAN
}

enum ContractFamily {
  MITRA
  PKWT
}

enum TerminationType {
  RESIGN
  PHK
}

enum AdminRole {
  ADMIN
  PENGELOLA_KOPERASI
}

model DocumentType {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(255)
  documentType String @db.VarChar(50)
  issuer       String @db.VarChar(255)

  employeeDocuments EmployeeDocument[]

  @@map("document_types")
}

model EmployeeDocument {
  id             Int          @id @default(autoincrement())
  employeeId     Int
  documentTypeId Int
  documentNumber String       @db.VarChar(100)
  expiryDate     DateTime     @db.Date
  notes          String?      @db.Text
  fileUrl        String?      @db.VarChar(500)
  status         DocStatus    @default(AKTIF)
  employee       Employee     @relation(fields: [employeeId], references: [id])
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("employee_documents")
}

enum DocStatus {
  AKTIF
  AKAN_EXPIRED
  EXPIRED
}

model Company {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(255)
  address String? @db.Text
  email   String? @db.VarChar(255)
  phone   String? @db.VarChar(50)

  vendorContracts    VendorContract[]

  @@map("companies")
}

enum VendorContractCategory {
  CUSTOMER
  VENDOR
}

enum VendorContractStatus {
  AKTIF
  AKAN_BERAKHIR
  EXPIRED
  TIDAK_AKTIF
}

enum VendorDocType {
  DOKUMEN_KONTRAK
  DOKUMEN_PERJANJIAN
  SURAT_PENAWARAN
  ADDENDUM
  AMENDMENT
  SURAT
}

model VendorContract {
  id                Int                     @id @default(autoincrement())
  category          VendorContractCategory
  companyId         Int
  documentName      String                  @db.VarChar(255)
  documentNumber    String                  @db.VarChar(100)
  documentType      VendorDocType
  createdDate       DateTime                @db.Date
  needsRenewal      Boolean                 @default(false)
  startDate         DateTime?               @db.Date
  endDate           DateTime?               @db.Date
  status            VendorContractStatus    @default(TIDAK_AKTIF)
  motherAgreementId Int?
  renewedFromId     Int?                    @unique
  location          String?                 @db.VarChar(255)
  notes             String?                 @db.Text
  fileUrl           String?                 @db.VarChar(500)
  company           Company                 @relation(fields: [companyId], references: [id])
  motherAgreement   VendorContract?         @relation("VendorContractRenewal", fields: [motherAgreementId], references: [id])
  renewals          VendorContract[]        @relation("VendorContractRenewal")
  renewedFrom       VendorContract?         @relation("ContractSuccession", fields: [renewedFromId], references: [id])
  renewedTo         VendorContract?         @relation("ContractSuccession")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@map("vendor_contracts")
}

enum LegalKoperasiCategory {
  IZIN
  SERTIFIKAT
  KEBIJAKAN
  DOKUMEN_INTERNAL
  DOKUMEN_B3
  LAIN_LAIN
}

enum LegalKoperasiStatus {
  AKTIF
  AKAN_BERAKHIR
  EXPIRED
  TIDAK_AKTIF
}

model LegalKoperasi {
  id              Int                     @id @default(autoincrement())
  category        LegalKoperasiCategory
  documentName    String                  @db.VarChar(255)
  documentNumber  String                  @db.VarChar(100)
  publisher       String                  @db.VarChar(255)
  documentDate    DateTime                @db.Date
  needsRenewal    Boolean                 @default(false)
  startDate       DateTime?               @db.Date
  endDate         DateTime?               @db.Date
  status          LegalKoperasiStatus     @default(TIDAK_AKTIF)
  location        String?                 @db.VarChar(255)
  notes           String?                 @db.Text
  fileUrl         String?                 @db.VarChar(500)
  renewedFromId   Int?                    @unique
  renewedFrom     LegalKoperasi?          @relation("LegalSuccession", fields: [renewedFromId], references: [id])
  renewedTo       LegalKoperasi?          @relation("LegalSuccession")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@map("legal_koperasi")
}

enum NotificationCategory {
  KONTRAK_KARYAWAN
  SERTIFIKASI_IJIN
  KONTRAK_VENDOR
  LEGAL_KOPERASI
}

enum NotificationSeverity {
  WARNING
  CRITICAL
}

model Notification {
  id          Int                    @id @default(autoincrement())
  category    NotificationCategory
  severity    NotificationSeverity
  title       String                 @db.VarChar(255)
  message     String                 @db.VarChar(500)
  sourceType  String                 @db.VarChar(50)
  sourceId    Int
  triggerDay  Int
  deeplink    String                 @db.VarChar(255)
  isRead      Boolean                @default(false)
  readAt      DateTime?
  resolvedAt  DateTime?
  expiryDate  DateTime               @db.Date
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([sourceType, sourceId, triggerDay])
  @@index([isRead, resolvedAt])
  @@map("notifications")
}
