generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WorkLocation {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  employees Employee[]

  @@map("work_locations")
}

model TaxStatus {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  employees Employee[]

  @@map("tax_status")
}

model ContractType {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(255)
  contracts Contract[]
  templates ContractTemplate[]

  @@map("contract_types")
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(255)
  employees Employee[]

  @@map("departments")
}

model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model UserAccount {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  nik       String    @unique @db.VarChar(100)
  email     String    @unique @db.VarChar(255)
  role      AdminRole @default(PENGELOLA_KOPERASI)
  username  String    @unique @db.VarChar(100)
  password  String    @db.VarChar(255)
  photoUrl  String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailNotificationRecipient EmailNotificationRecipient?

  @@map("user_accounts")
}

model JobRole {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  employees Employee[]
  contractTemplates ContractTemplate[]

  @@map("job_roles")
}

model JobLevel {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  employees Employee[]

  @@map("job_levels")
}

model Employee {
  id               Int              @id @default(autoincrement())
  employeeNo       String           @unique @db.VarChar(100)
  fullName         String           @db.VarChar(255)
  nik              String?          @unique @db.VarChar(100)
  birthPlace       String?          @db.VarChar(100)
  address          String?
  employmentStatus EmploymentStatus
  taxStatusId      Int
  departmentId     Int?
  birthDate        DateTime         @db.Date
  gender           Gender
  workLocationId   Int
  jobRoleId        Int
  jobLevelId       Int
  educationLevel   EducationLevel
  joinDate         DateTime         @db.Date
  phoneNumber      String?          @db.VarChar(50)
  email            String           @unique @db.VarChar(255)
  fotoKaryawan     String?

  taxStatus    TaxStatus    @relation(fields: [taxStatusId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workLocation WorkLocation @relation(fields: [workLocationId], references: [id])
  jobRole      JobRole      @relation(fields: [jobRoleId], references: [id])
  jobLevel     JobLevel     @relation(fields: [jobLevelId], references: [id])

  contracts             Contract[]
  statusHistory         EmployeeStatusHistory[]
  offboarding           EmployeeOffboarding?
  masterAdmin           MasterAdmin?
  warningLetters        WarningLetter[]
  employeeDocuments     EmployeeDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

model WarningLetter {
  id              Int      @id @default(autoincrement())
  letterNumber    String   @unique @db.VarChar(100)
  employeeId      Int
  violationType   String[] @db.Text
  warningLevel    Int
  letterDate      DateTime @db.Date
  validUntil      DateTime @db.Date
  processedById   Int
  processedByName String   @db.VarChar(255)
  documentUrl     String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warning_letters")
}

model MasterAdmin {
  id         Int       @id @default(autoincrement())
  employeeNo String    @unique @db.VarChar(100)
  fullName   String    @db.VarChar(255)
  password   String    @db.VarChar(255)
  role       AdminRole @default(ADMIN)
  photoUrl   String?   @db.VarChar(500)
  employee   Employee  @relation(fields: [employeeNo], references: [employeeNo])

  @@map("master_admin")
}

model Contract {
  id             Int            @id @default(autoincrement())
  employeeId     Int
  contractNo     String         @unique @db.VarChar(100)
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  contractTypeId Int?
  templateId     Int?
  status         ContractStatus @default(AKTIF)
  signedDate     DateTime?      @db.Date
  positionLabel  String?        @db.VarChar(255)
  workLocationLabel String?     @db.VarChar(255)
  baseCompensation Int?
  templateData   Json?
  documentUrl    String?
  generatedPdfUrl String?
  generatedAt    DateTime?
  parentContractId Int?

  employee       Employee           @relation(fields: [employeeId], references: [id])
  contractType   ContractType?      @relation(fields: [contractTypeId], references: [id])
  template       ContractTemplate?  @relation(fields: [templateId], references: [id])
  parentContract Contract?          @relation("ContractChain", fields: [parentContractId], references: [id])
  childContracts Contract[]         @relation("ContractChain")
  documents      ContractDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contracts")
}

model ContractTemplate {
  id             Int            @id @default(autoincrement())
  code           String         @unique @db.VarChar(100)
  name           String         @db.VarChar(255)
  family         ContractFamily
  contractTypeId Int?
  jobRoleId      Int?
  description    String?
  templateKey    String         @db.VarChar(100)
  requiredFields   Json?
  contentOverrides Json?
  isActive         Boolean        @default(true)
  version        Int            @default(1)
  notes          String?

  contractType ContractType? @relation(fields: [contractTypeId], references: [id], onDelete: SetNull)
  jobRole      JobRole?      @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  contracts    Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contract_templates")
}

model ContractDocument {
  id         Int      @id @default(autoincrement())
  contractId Int
  fileName   String   @db.VarChar(255)
  fileUrl    String
  uploadedAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id])

  @@map("contract_documents")
}

model EmployeeStatusHistory {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  oldStatus     String   @db.VarChar(30)
  newStatus     String   @db.VarChar(30)
  changedById   Int?
  changedByName String   @db.VarChar(255)
  changedByRole String   @db.VarChar(50)
  changedAt     DateTime @default(now())
  notes         String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_status_history")
}

model EmployeeOffboarding {
  id              Int             @id @default(autoincrement())
  employeeId      Int             @unique
  terminationType TerminationType
  terminationDate DateTime        @db.Date
  reason          String?
  processedById   Int
  processedByName String          @db.VarChar(255)
  processedByRole String          @db.VarChar(50)
  processedByKind String          @db.VarChar(50)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_offboarding")
}

enum EmploymentStatus {
  AKTIF
  KONTRAK_EXPIRED
  RESIGN
  PHK
}

enum Gender {
  MALE
  FEMALE
}

enum EducationLevel {
  SMA
  D3
  S1
  S2
}

enum ContractStatus {
  DRAFT
  AKTIF
  AKAN_HABIS
  EXPIRED
  SELESAI
  DIBATALKAN
}

enum ContractFamily {
  MITRA
  PKWT
}

enum TerminationType {
  RESIGN
  PHK
}

enum AdminRole {
  ADMIN
  PENGELOLA_KOPERASI
}

enum DocCategory {
  PERSONAL
  CERTIFICATION
}

model DocumentType {
  id           Int         @id @default(autoincrement())
  name         String      @db.VarChar(255)
  documentType String      @db.VarChar(50)
  issuer       String      @db.VarChar(255)
  category     DocCategory @default(CERTIFICATION)

  employeeDocuments EmployeeDocument[]

  @@map("document_types")
}

model EmployeeDocument {
  id             Int          @id @default(autoincrement())
  employeeId     Int
  documentTypeId Int
  documentNumber String       @db.VarChar(100)
  expiryDate     DateTime?    @db.Date
  notes          String?      @db.Text
  fileUrl        String?      @db.VarChar(500)
  status         DocStatus    @default(AKTIF)
  employee       Employee     @relation(fields: [employeeId], references: [id])
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("employee_documents")
}

enum DocStatus {
  AKTIF
  AKAN_EXPIRED
  EXPIRED
}

model Company {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(255)
  address String? @db.Text
  email   String? @db.VarChar(255)
  phone   String? @db.VarChar(50)

  vendorContracts    VendorContract[]

  @@map("companies")
}

enum VendorContractCategory {
  CUSTOMER
  VENDOR
}

enum VendorContractStatus {
  AKTIF
  AKAN_BERAKHIR
  EXPIRED
  TIDAK_AKTIF
}

enum VendorDocType {
  DOKUMEN_KONTRAK
  DOKUMEN_PERJANJIAN
  SURAT_PENAWARAN
  ADDENDUM
  AMENDMENT
  SURAT
}

model VendorContract {
  id                Int                     @id @default(autoincrement())
  category          VendorContractCategory
  companyId         Int
  documentName      String                  @db.VarChar(255)
  documentNumber    String                  @db.VarChar(100)
  documentType      VendorDocType
  createdDate       DateTime                @db.Date
  needsRenewal      Boolean                 @default(false)
  startDate         DateTime?               @db.Date
  endDate           DateTime?               @db.Date
  status            VendorContractStatus    @default(TIDAK_AKTIF)
  motherAgreementId Int?
  renewedFromId     Int?                    @unique
  location          String?                 @db.VarChar(255)
  notes             String?                 @db.Text
  fileUrl           String?                 @db.VarChar(500)
  company           Company                 @relation(fields: [companyId], references: [id])
  motherAgreement   VendorContract?         @relation("VendorContractRenewal", fields: [motherAgreementId], references: [id])
  renewals          VendorContract[]        @relation("VendorContractRenewal")
  renewedFrom       VendorContract?         @relation("ContractSuccession", fields: [renewedFromId], references: [id])
  renewedTo         VendorContract?         @relation("ContractSuccession")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@map("vendor_contracts")
}

enum LegalKoperasiCategory {
  IZIN
  SERTIFIKAT
  KEBIJAKAN
  DOKUMEN_INTERNAL
  DOKUMEN_B3
  LAIN_LAIN
}

enum LegalKoperasiStatus {
  AKTIF
  AKAN_BERAKHIR
  EXPIRED
  TIDAK_AKTIF
}

model LegalKoperasi {
  id              Int                     @id @default(autoincrement())
  category        LegalKoperasiCategory
  documentName    String                  @db.VarChar(255)
  documentNumber  String                  @db.VarChar(100)
  publisher       String                  @db.VarChar(255)
  documentDate    DateTime                @db.Date
  needsRenewal    Boolean                 @default(false)
  startDate       DateTime?               @db.Date
  endDate         DateTime?               @db.Date
  status          LegalKoperasiStatus     @default(TIDAK_AKTIF)
  location        String?                 @db.VarChar(255)
  notes           String?                 @db.Text
  fileUrl         String?                 @db.VarChar(500)
  renewedFromId   Int?                    @unique
  renewedFrom     LegalKoperasi?          @relation("LegalSuccession", fields: [renewedFromId], references: [id])
  renewedTo       LegalKoperasi?          @relation("LegalSuccession")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@map("legal_koperasi")
}

model AkteDokumen {
  id          Int       @id @default(autoincrement())
  tanggal     DateTime  @db.Date
  notaris     String    @db.VarChar(255)
  nomorAkte   String    @map("nomor_akte") @db.VarChar(100)
  judulAkte   String    @map("judul_akte") @db.VarChar(255)
  nomorSk     String?   @map("nomor_sk") @db.VarChar(100)
  tanggalSk   DateTime? @map("tanggal_sk") @db.Date
  keterangan  String?   @db.Text
  fileUrl     String?   @map("file_url") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("akte_dokumen")
}

enum NotificationCategory {
  KONTRAK_KARYAWAN
  SERTIFIKASI_IJIN
  KONTRAK_VENDOR
  LEGAL_KOPERASI
  AGENDA
  SPACE
}

enum NotificationSeverity {
  WARNING
  CRITICAL
}

model Notification {
  id          Int                    @id @default(autoincrement())
  category    NotificationCategory
  severity    NotificationSeverity
  title       String                 @db.VarChar(255)
  message     String                 @db.VarChar(500)
  sourceType  String                 @db.VarChar(50)
  sourceId    Int
  triggerDay  Int
  deeplink    String                 @db.VarChar(255)
  userId      Int?
  userType    String?                @db.VarChar(20)
  isRead      Boolean                @default(false)
  readAt      DateTime?
  resolvedAt  DateTime?
  expiryDate  DateTime               @db.Date
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([sourceType, sourceId, triggerDay])
  @@index([isRead, resolvedAt])
  @@index([userId, userType])
  @@map("notifications")
}

model EmailNotificationRecipient {
  id            Int         @id @default(autoincrement())
  userAccountId Int
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userAccountId])
  @@map("email_notification_recipients")
}

model EmailNotificationSentLog {
  id         Int      @id @default(autoincrement())
  sourceType String   @db.VarChar(50)
  sourceId   Int
  triggerDay Int
  sentAt     DateTime @default(now())

  @@unique([sourceType, sourceId, triggerDay])
  @@map("email_notification_sent_log")
}

model EmailNotificationConfigLog {
  id          Int      @id @default(autoincrement())
  changedBy   String   @db.VarChar(255)
  description String   @db.Text
  createdAt   DateTime @default(now())

  @@map("email_notification_config_log")
}

model CalendarEvent {
  id                Int      @id @default(autoincrement())
  title             String   @db.VarChar(255)
  description       String?  @db.Text
  location          String?  @db.VarChar(255)
  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  startTime         String   @db.VarChar(5)
  endTime           String?  @db.VarChar(5)
  color             String   @default("blue") @db.VarChar(20)
  createdByName     String   @db.VarChar(255)
  assignedUserIds   Int[]    @default([])
  notifyMorningSent Boolean  @default(false)
  notifyBeforeSent  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([startDate, endDate])
  @@map("calendar_events")
}

// ── Space (Kanban Board) ─────────────────────────────────────────────────────

enum CardPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttachmentType {
  FILE
  LINK
}

model Space {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(255)
  description   String?       @db.Text
  icon          String?       @db.VarChar(50)
  color         String        @default("blue") @db.VarChar(20)
  createdById   Int
  createdByType String        @db.VarChar(20)
  memberIds     Int[]         @default([])
  memberTypes   String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  columns       SpaceColumn[]
  announcements SpaceAnnouncement[]
  documents     SpaceDocument[]

  @@map("spaces")
}

model SpaceColumn {
  id        Int         @id @default(autoincrement())
  spaceId   Int
  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name      String      @db.VarChar(100)
  color     String      @default("gray") @db.VarChar(20)
  position  Int
  cards     SpaceCard[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([spaceId, position])
  @@map("space_columns")
}

model SpaceCard {
  id          Int                   @id @default(autoincrement())
  columnId    Int
  column      SpaceColumn           @relation(fields: [columnId], references: [id], onDelete: Cascade)
  title       String                @db.VarChar(255)
  description String?               @db.Text
  position    Int
  priority    CardPriority          @default(NONE)
  dueDate     DateTime?             @db.Date
  assigneeIds Int[]                 @default([])
  labels      String[]              @default([])
  coverColor  String?               @db.VarChar(20)
  createdById Int
  createdByType String              @db.VarChar(20)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  checklists  SpaceCardChecklist[]
  attachments SpaceCardAttachment[]
  comments    SpaceCardComment[]

  @@index([columnId, position])
  @@map("space_cards")
}

model SpaceCardChecklist {
  id        Int       @id @default(autoincrement())
  cardId    Int
  card      SpaceCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(255)
  checked   Boolean   @default(false)
  position  Int
  createdAt DateTime  @default(now())

  @@index([cardId, position])
  @@map("space_card_checklists")
}

model SpaceCardAttachment {
  id        Int            @id @default(autoincrement())
  cardId    Int
  card      SpaceCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  type      AttachmentType
  name      String         @db.VarChar(255)
  url       String         @db.VarChar(500)
  mimeType  String?        @db.VarChar(100)
  size      Int?
  createdAt DateTime       @default(now())

  @@index([cardId])
  @@map("space_card_attachments")
}

model SpaceCardComment {
  id          Int       @id @default(autoincrement())
  cardId      Int
  card        SpaceCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  content     String    @db.Text
  authorId    Int
  authorType  String    @db.VarChar(20)
  authorName  String    @db.VarChar(255)
  authorPhotoUrl String? @db.Text
  isEdited    Boolean   @default(false)
  editedAt    DateTime?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([cardId])
  @@map("space_card_comments")
}

model SpaceAnnouncement {
  id            Int      @id @default(autoincrement())
  spaceId       Int
  space         Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  content       String   @db.Text
  isPinned      Boolean  @default(true)
  createdById   Int
  createdByName String   @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([spaceId])
  @@map("space_announcements")
}

model SpaceDocument {
  id            Int      @id @default(autoincrement())
  spaceId       Int
  space         Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  title         String   @db.VarChar(255)
  content       String   @db.Text
  emoji         String?  @db.VarChar(10)
  createdById   Int
  createdByName String   @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([spaceId])
  @@map("space_documents")
}
