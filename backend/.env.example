# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kokarsi_karyawan"

# JWT — gunakan random string minimal 32 karakter
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Server
PORT=3001

# Email (Maileroo)
MAILEROO_API_KEY=
MAILEROO_FROM_EMAIL=noreply@yourdomain.com
MAILEROO_FROM_NAME=Kokarsi System

# Font path untuk PDF generator (opsional, default sesuai OS)
# Windows: C:/Windows/Fonts
# Linux/Docker: /usr/share/fonts/truetype
FONT_DIR=

# Hari Libur Nasional Indonesia (api.co.id)
# Daftar: https://api.co.id/indonesia-holiday-calender-api
# Jika tidak diset, fitur hari libur di kalender akan dinonaktifkan
HOLIDAY_API_KEY=
