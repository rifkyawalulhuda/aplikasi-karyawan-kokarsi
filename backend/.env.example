# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kokarsi_karyawan"

# JWT — gunakan random string minimal 32 karakter
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# JWT sliding session (opsional)
# JWT_ACCESS_EXPIRES_IN  : masa berlaku access token (default 15m)
#                          — harus sinkron dengan ACCESS_TTL_SECONDS di server/utils/auth-cookies.ts
# JWT_REFRESH_SECRET     : secret terpisah untuk refresh token (disarankan beda dari JWT_SECRET)
# JWT_REFRESH_EXPIRES_IN : masa berlaku refresh token (default 7d)
#                          — harus sinkron dengan REFRESH_TTL_SECONDS di server/utils/auth-cookies.ts
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3001

# Email (Maileroo)
MAILEROO_API_KEY=
MAILEROO_FROM_EMAIL=noreply@yourdomain.com
MAILEROO_FROM_NAME=Kokarsi System

# Font path untuk PDF generator (opsional, default sesuai OS)
# Windows: C:/Windows/Fonts
# Linux/Docker: /usr/share/fonts/truetype
FONT_DIR=

# Hari Libur Nasional Indonesia (api.co.id)
# Daftar: https://api.co.id/indonesia-holiday-calender-api
# Jika tidak diset, fitur hari libur di kalender akan dinonaktifkan
HOLIDAY_API_KEY=

#khusus di mesin Production
CORS_ORIGINS=https://kokarsi-sankyu.web.id,http://localhost:3000